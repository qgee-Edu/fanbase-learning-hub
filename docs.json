{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Fanbase Support Center",
  "description": "The official learning hub for Fanbase creators. Learn how to earn, grow, and master every feature on the platform.",
  "colors": {
    "primary": "#9824FF",
    "light": "#C77DFF",
    "dark": "#FF00D6"
  },
  "background": {
    "decoration": "gradient",
    "color": {
      "light": "#FAFAFA",
      "dark": "#0A0118"
    }
  },
  "appearance": {
    "default": "dark"
  },
  "fonts": {
    "heading": {
      "family": "Inter",
      "weight": 700
    },
    "body": {
      "family": "Inter",
      "weight": 400
    }
  },
  "favicon": "/images/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Home",
        "pages": ["index"]
      },
      {
        "tab": "Business Center",
        "groups": [
          {
            "group": "Business Center",
            "pages": [
              "business-center/overview",
              "business-center/getting-paid",
              "business-center/payment-account-setup",
              "business-center/subscriptions-and-pricing"
            ]
          }
        ]
      },
      {
        "tab": "Knowledge Center",
        "groups": [
          {
            "group": "Knowledge Center",
            "pages": [
              "knowledge-center/overview",
              "knowledge-center/getting-started",
              "knowledge-center/fanbase-features"
            ]
          }
        ]
      },
      {
        "tab": "Creator Academy",
        "groups": [
          {
            "group": "Creator Academy",
            "pages": [
              "creator-academy/overview",
              "creator-academy/monetize-basics",
              "creator-academy/content-strategy",
              "creator-academy/creator-insights-and-spotlights"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Fanbase App",
          "href": "https://fanbase.app",
          "icon": "mobile"
        },
        {
          "anchor": "Creator Support",
          "href": "mailto:support@fanbase.app",
          "icon": "envelope"
        }
      ]
    }
  },
  "logo": {
    "light": "/images/logo-light.svg",
    "dark": "/images/logo-dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Open App",
        "href": "https://fanbase.app"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "/knowledge-center/getting-started"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/fanbase",
      "instagram": "https://instagram.com/fanbaseapp"
    }
  }
}
